# ══════════════════════════════════════════════
# CORE SERVER
# ══════════════════════════════════════════════
NODE_ENV=development
PORT=5000

# ══════════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════════
# Local development:
MONGO_URI=mongodb://localhost:27017/freshnaps
# Production (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/freshnaps?retryWrites=true&w=majority

# ══════════════════════════════════════════════
# AUTHENTICATION
# ══════════════════════════════════════════════
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=30d

# ══════════════════════════════════════════════
# URLS
# ══════════════════════════════════════════════
FRONTEND_URL=http://localhost:5173
UPLOAD_PATH=uploads/

# ══════════════════════════════════════════════
# CLOUDINARY — Image CDN
# Without these, images store locally in /uploads/
# ══════════════════════════════════════════════
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ══════════════════════════════════════════════
# PAYMENTS (optional — falls back to sandbox mock)
# ══════════════════════════════════════════════
# Stripe
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Razorpay
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# ══════════════════════════════════════════════
# EMAIL — Resend (optional — falls back to console logs)
# ══════════════════════════════════════════════
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# FROM_EMAIL=Freshnaps <orders@freshnaps.com>

# ══════════════════════════════════════════════
# SMS — Twilio (optional — falls back to console logs)
# ══════════════════════════════════════════════
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ══════════════════════════════════════════════
# WHATSAPP — Meta Business API (optional)
# ══════════════════════════════════════════════
# WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx
# WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxx
